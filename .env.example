# Slack App credentials (https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# Channel ID untuk handoff ke CLT (klik kanan channel → View channel details → copy ID di bawah)
CS_CHANNEL=C0123456789

# OpenAI-compatible LLM endpoint
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=gc/gemini-2.5-flash

# Optional: untuk tunnel lokal (atau set via `ngrok config add-authtoken`)
# NGROK_AUTHTOKEN=your-ngrok-token
