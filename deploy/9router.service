[Unit]
Description=9router LLM gateway (loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ninerouter
Group=ninerouter
WorkingDirectory=/home/ninerouter

# 9router bundles Next.js 16, which requires Node >=20.9 -- its own
# package.json engines field says >=18 and is stale. This uses a Node kept in
# the ninerouter home so the system /usr/bin/node (used by other services'
# asset pipeline) is never touched. cli.js is invoked directly rather than via
# the bin shim so the correct interpreter is guaranteed.
ExecStart=/home/ninerouter/nodejs/bin/node \
          /home/ninerouter/.npm-global/lib/node_modules/9router/cli.js \
          --host 127.0.0.1 --port 20128 --no-browser --skip-update

Restart=always
RestartSec=10

MemoryMax=1G
CPUQuota=75%
TasksMax=512

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ninerouter/.9router
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
